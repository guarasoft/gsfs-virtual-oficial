{
  "$meta": {
    "project": "GSFS Virtual",
    "version": "0.2",
    "status": "proposta Result — sujeito a validação do cliente",
    "date": "2026-05-26",
    "note": "Fonte única de tokens. As 7 cores em color.brand.* foram entregues pelo cliente; demais escalas e tokens semânticos são proposta Result."
  },
  "color": {
    "brand": {
      "deepNavy": "#0A1324",
      "deepBlue": "#0D1F3A",
      "steelBlue": "#1E3A5F",
      "technicalCyan": "#00B6C8",
      "controlledGreen": "#7ED321",
      "lightGray": "#E6EAF0",
      "white": "#FFFFFF"
    },
    "scale": {
      "navy":   { "500": "#3A659E", "600": "#2B4F7E", "700": "#1E3A5F", "800": "#14294A", "900": "#0D1F3A", "950": "#0A1324" },
      "cyan":   { "50": "#E0F7FA", "100": "#B8EEF3", "200": "#8AE3EC", "300": "#5AD7E4", "400": "#2BC8D9", "500": "#00B6C8", "600": "#0095A4", "700": "#007580", "800": "#00565E", "900": "#00383D" },
      "green":  { "50": "#F0FBE2", "100": "#DCF5BD", "200": "#C2ED90", "300": "#A6E563", "400": "#8FDB3D", "500": "#7ED321", "600": "#66B015", "700": "#4E8A10", "800": "#3A660C", "900": "#284807" },
      "amber":  { "50": "#FFF6E5", "100": "#FFE7B8", "200": "#FFD588", "300": "#FFC152", "400": "#FFB02E", "500": "#F5A623", "600": "#D9870D", "700": "#AD6A0A", "800": "#824F08", "900": "#573504" },
      "red":    { "50": "#FDECEC", "100": "#FBD0D0", "200": "#F7A8A8", "300": "#F27F7F", "400": "#ED5A5A", "500": "#E5484D", "600": "#C7363B", "700": "#9E2A2E", "800": "#761F22", "900": "#4F1517" },
      "neutral":{ "0": "#FFFFFF", "50": "#F5F7FA", "100": "#E6EAF0", "200": "#C9D2E0", "300": "#A6B2C6", "400": "#8190A8", "500": "#5F6E88", "600": "#455068", "700": "#303A4E", "800": "#1E2536", "900": "#0E1322" }
    },
    "semantic": {
      "bg": "{color.scale.navy.950}",
      "bgSurface": "{color.scale.navy.900}",
      "bgRaised": "{color.scale.navy.800}",
      "border": "{color.scale.navy.700}",
      "borderSubtle": "{color.scale.navy.800}",
      "borderStrong": "{color.scale.cyan.700}",
      "text": "{color.scale.neutral.100}",
      "textStrong": "{color.scale.neutral.0}",
      "textMuted": "{color.scale.neutral.400}",
      "textDisabled": "{color.scale.neutral.500}",
      "textInverse": "{color.scale.navy.950}",
      "primary": "{color.scale.cyan.500}",
      "primaryHover": "{color.scale.cyan.400}",
      "primaryActive": "{color.scale.cyan.600}",
      "onPrimary": "{color.scale.navy.950}",
      "accent": "{color.scale.green.500}",
      "success": "{color.scale.green.500}",
      "warning": "{color.scale.amber.500}",
      "danger": "{color.scale.red.500}",
      "info": "{color.scale.cyan.500}",
      "focusRing": "{color.scale.cyan.400}"
    },
    "simulator": {
      "stateConfirmed": "{color.scale.green.500}",
      "stateSuspect": "{color.scale.amber.500}",
      "stateDiscarded": "{color.scale.red.500}",
      "confidenceHigh": "{color.scale.green.500}",
      "confidenceMedium": "{color.scale.amber.500}",
      "confidenceLow": "{color.scale.red.400}",
      "degradationFill": "rgba(229, 72, 77, 0.18)",
      "degradationEdge": "{color.scale.red.600}",
      "batteryOk": "{color.scale.green.500}",
      "batteryWarn": "{color.scale.amber.500}",
      "batteryCritical": "{color.scale.red.500}",
      "tempNormal": "{color.scale.cyan.500}",
      "tempElevated": "{color.scale.amber.500}",
      "tempCritical": "{color.scale.red.500}",
      "sensorOn": "{color.scale.green.500}",
      "sensorOff": "{color.scale.neutral.500}",
      "sensorErr": "{color.scale.red.500}",
      "rtkFix": "{color.scale.green.500}",
      "rtkFloat": "{color.scale.amber.500}",
      "rtkNofix": "{color.scale.red.500}",
      "sensorGpr": "{color.scale.cyan.500}",
      "sensorEmi": "{color.scale.amber.400}",
      "sensorImu": "{color.scale.green.500}",
      "sensorGnss": "{color.scale.cyan.300}",
      "emiHeat": ["{color.scale.navy.800}", "{color.scale.cyan.600}", "{color.scale.green.500}", "{color.scale.amber.500}", "{color.scale.red.500}"]
    },
    "gradient": {
      "$note": "Gradiente oficial do cliente (palette bar v1.0): navy → cyan → green",
      "brand": "linear-gradient(90deg, #0A1324 0%, #1E3A5F 35%, #00B6C8 70%, #7ED321 100%)",
      "brandVertical": "linear-gradient(180deg, #0A1324 0%, #00B6C8 70%, #7ED321 100%)"
    },
    "state": {
      "$note": "Estados interativos (proposta Result) — hover/active/disabled/foco.",
      "hoverOverlay": "rgba(255, 255, 255, 0.06)",
      "activeOverlay": "rgba(255, 255, 255, 0.12)",
      "selectedOverlay": "rgba(0, 182, 200, 0.16)",
      "disabledOpacity": 0.4,
      "focusRing": { "color": "{color.scale.cyan.400}", "width": "2px", "offset": "2px" },
      "button": {
        "primary":   { "bg": "{color.scale.cyan.500}", "bgHover": "{color.scale.cyan.400}", "bgActive": "{color.scale.cyan.600}", "fg": "{color.scale.navy.950}", "bgDisabled": "{color.scale.navy.700}", "fgDisabled": "{color.scale.neutral.500}" },
        "secondary": { "border": "{color.scale.cyan.700}", "fg": "{color.scale.cyan.500}", "bgHover": "rgba(0, 182, 200, 0.12)" },
        "ghost":     { "fg": "{color.scale.neutral.100}", "bgHover": "rgba(255, 255, 255, 0.06)" },
        "danger":    { "bg": "{color.scale.red.500}", "fg": "{color.scale.neutral.0}" }
      },
      "input": {
        "bg": "{color.scale.navy.800}", "border": "{color.scale.navy.700}", "borderHover": "{color.scale.navy.600}",
        "borderFocus": "{color.scale.cyan.400}", "borderError": "{color.scale.red.500}",
        "fg": "{color.scale.neutral.100}", "placeholder": "{color.scale.neutral.400}", "bgDisabled": "{color.scale.navy.900}"
      }
    }
  },
  "typography": {
    "$note": "Cliente (v1.0): primária Exo 2 (hierarquia editorial/marca) + secundária Inter (UI, captions, data interfaces). Mono é complemento Result apenas para strings monoespaçadas.",
    "fontFamily": {
      "primary": "'Exo 2', system-ui, 'Segoe UI', sans-serif",
      "secondary": "'Inter', system-ui, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', Consolas, ui-monospace, monospace"
    },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "roles": {
      "h1":   { "family": "primary", "weight": 800, "size": "3rem",     "lineHeight": 1.167, "comment": "48/56 ExtraBold (cliente)" },
      "h2":   { "family": "primary", "weight": 700, "size": "1.75rem",  "lineHeight": 1.286, "comment": "28/36 Bold (cliente)" },
      "h3":   { "family": "primary", "weight": 600, "size": "1.125rem", "lineHeight": 1.333, "comment": "18/24 SemiBold (cliente)" },
      "body": { "family": "primary", "weight": 400, "size": "0.875rem", "lineHeight": 1.571, "comment": "14/22 Regular (cliente) — copy editorial/marca" },
      "caps": { "family": "primary", "weight": 500, "size": "0.75rem",  "lineHeight": 1.333, "comment": "12/16 Medium (cliente)", "transform": "uppercase", "letterSpacing": "0.04em" },
      "ui":      { "family": "secondary", "weight": 400, "size": "0.875rem", "lineHeight": 1.571, "comment": "Inter (cliente) — interface, captions, dados" },
      "uiLabel": { "family": "secondary", "weight": 600, "size": "0.75rem", "lineHeight": 1.333, "transform": "uppercase", "letterSpacing": "0.08em", "comment": "Inter — label de HUD/status" },
      "metric":  { "family": "secondary", "weight": 600, "size": "2rem", "lineHeight": 1.1, "numeric": "tabular-nums", "comment": "Inter tabular — métricas HUD" },
      "data":    { "family": "mono", "weight": 400, "size": "0.875rem", "lineHeight": 1.4, "comment": "complemento Result — hash hex / coordenadas em coluna" }
    },
    "letterSpacing": { "tight": "-0.01em", "normal": "0", "wide": "0.04em", "wider": "0.08em" }
  },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "pill": "999px" },
  "spacing": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px" }
}
